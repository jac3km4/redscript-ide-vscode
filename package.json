{
  "name": "redscript-ide-vscode",
  "displayName": "REDscript IDE",
  "description": "REDscript language server integration for VSCode",
  "publisher": "jac3km4",
  "version": "0.4.0",
  "repository": "https://github.com/jac3km4/redscript-ide-vscode",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:redscript",
    "onLanguage:redmod"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "redscript",
        "aliases": [
          "redscript"
        ],
        "extensions": [
          ".reds"
        ],
        "configuration": "./redscript-language-configuration.json"
      },
      {
        "id": "redmod",
        "aliases": [
          "REDmod",
          "redmod"
        ],
        "extensions": [
          ".script"
        ],
        "configuration": "./redmod-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "redscript",
        "scopeName": "source.redscript",
        "path": "./syntaxes/redscript.tmLanguage.json"
      },
      {
        "language": "redmod",
        "scopeName": "source.redmod",
        "path": "./syntaxes/redmod.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "REDscript",
      "properties": {
        "redscript.gameDir": {
          "type": "string",
          "description": "Path to the Cyberpunk 2077 installation directory (should contain r6, tools, bin etc.)"
        },
        "redscript.scriptCachePath": {
          "type": "string",
          "description": "Path to the compiled script cache file to load (optional, can be used instead of redscript.gameDir)"
        },
        "redscript.ideVersion": {
          "type": "string",
          "description": "Version of REDscript IDE to download, for example '0.2.0' (optional, the default behavior is to check for latest)"
        },
        "redscript.idePath": {
          "type": "string",
          "description": "Path to a local REDscript IDE executable to use (optional, prevents downloads from the Github API)"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "extension.redscript.attach",
          "when": "resourceLangId == redscript"
        }
      ]
    },
    "commands": [
      {
        "command": "extension.redscript.attach",
        "title": "Attach to Cyberpunk 2077",
        "category": "REDscript",
        "enablement": "!inDebugMode",
        "icon": "$(debug-alt)"
      }
    ],
    "breakpoints": [
      {
        "language": "redscript"
      }
    ],
    "debuggers": [
      {
        "type": "redscript",
        "languages": [
          "redscript"
        ],
        "label": "REDscript DAP",
        "initialConfigurations": [
          {
            "type": "redscript",
            "request": "attach",
            "name": "Attach to Cyberpunk 2077"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --platform=node --format=cjs --target=node20 --external:vscode",
    "compile": "npm run typecheck && npm run build",
    "test": "node --test test/*.test.cjs",
    "watch": "npm run build -- --watch",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "node-fetch": "^3.3.2",
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.91.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "5.9.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
